# ===========================================
# CHECKLIST CCO - Variáveis de Ambiente
# ===========================================
# Copie este arquivo para .env e preencha os valores
# NUNCA commit o arquivo .env com dados sensíveis

# -------------------------------------------
# Google Gemini (IA)
# -------------------------------------------
GEMINI_API_KEY=sua_chave_aqui

# -------------------------------------------
# Microsoft Azure AD (Autenticação)
# -------------------------------------------
VITE_AZURE_CLIENT_ID=seu_client_id_aqui
VITE_AZURE_TENANT_ID=seu_tenant_id_aqui
VITE_AZURE_SCOPES=User.Read,Sites.ReadWrite.All

# -------------------------------------------
# Microsoft Azure AD (Viewer - 2º App Registration)
# -------------------------------------------
VITE_AZURE_VIEWER_CLIENT_ID=seu_client_id_viewer_aqui
VITE_AZURE_VIEWER_TENANT_ID=seu_tenant_id_viewer_aqui
VITE_AZURE_VIEWER_SCOPES=User.Read,Sites.ReadWrite.All
# Opcional: se não preencher, usa https://login.microsoftonline.com/VITE_AZURE_VIEWER_TENANT_ID
VITE_AZURE_VIEWER_AUTHORITY=

# -------------------------------------------
# SharePoint Online
# -------------------------------------------
VITE_SHAREPOINT_SITE_PATH=seu_site_sharepoint_aqui
VITE_VIEWER_ACCESS_LIST_NAME=Usuário_filial

# -------------------------------------------
# PostgreSQL - Eventos de Manutenção (server-side)
# -------------------------------------------
# Use SEM prefixo VITE_ para manter segredo no backend (Vercel Functions)
MAINT_DB_URL=postgresql://usuario:senha@host:5432/appdb
MAINT_DB_SSL=true
MAINT_DB_SCHEMA=public
MAINT_DB_TABLE=manutencoes

# -------------------------------------------
# PostgreSQL - Route Web Events (server-side)
# -------------------------------------------
# Use SEM prefixo VITE_ para manter segredo no backend (Vercel Functions)
RWE_DB_URL=postgresql://usuario:senha@host:5432/routedb
RWE_DB_SSL=true
RWE_DB_SCHEMA=public
RWE_DB_TABLE=route_web_events
# Opcional: secreto para proteger o endpoint do cron contra acesso não autorizado.
# Se vazio, qualquer um pode chamar /api/cron-sync-route-events.
CRON_SYNC_SECRET=

# Azure AD - Client Secret para app-only auth (cron lê configs do SharePoint)
# -------------------------------------------
# Usa o mesmo App Registration (VITE_AZURE_CLIENT_ID / VITE_AZURE_TENANT_ID).
# Gere um Client Secret no Azure AD > App registrations > Certificates & secrets.
# O App precisa da permissão Sites.Read.All (Application) com admin consent.
VITE_AZURE_CLIENT_SECRET=seu_client_secret_aqui

# -------------------------------------------
# PostgreSQL - Checklist Web (server-side)
# -------------------------------------------
# Banco checklist_web na EC2 — dados das 3 listas ativas migradas do SharePoint
# Use SEM prefixo VITE_ para manter segredo no backend (Vercel Functions)
CHECKLIST_DB_URL=postgresql://usuario:senha@host:5432/checklist_web
CHECKLIST_DB_SSL=true
CHECKLIST_DB_SCHEMA=public

# -------------------------------------------
# Route Web / RP API (server-side)
# -------------------------------------------
# Use SEM prefixo VITE_ para manter segredo no backend (Vercel Functions)
ROUTE_WEB_URL=https://api.auth.viagroup.com.br
ROUTE_WEB_CLIENT_ID=seu_client_id_aqui
ROUTE_WEB_CLIENT_SECRET=seu_client_secret_aqui
ROUTE_WEB_USERNAME=seu_username_aqui
ROUTE_WEB_PASSWORD=sua_senha_aqui
ROUTE_WEB_SCOPE=seu_scope_aqui
# Opcional: URL específica do endpoint de rotas (quando diferente da ROUTE_WEB_URL).
# Pode ser base (ex: https://api-outra.viagroup.com.br) ou endpoint completo
# (ex: https://api-outra.viagroup.com.br/api/routes).
# Se vazio, usa automaticamente ROUTE_WEB_URL + /api/routes.
ROUTE_WEB_ROUTES_URL=

# -------------------------------------------
# Webhooks (n8n)
# -------------------------------------------
VITE_WEBHOOK_SAIDAS_URL=https://n8n.datastack.viagroup.com.br/webhook/seu_webhook_aqui
VITE_WEBHOOK_NAO_COLETAS_URL=https://n8n.datastack.viagroup.com.br/webhook/seu_webhook_aqui
VITE_WEBHOOK_RESUMO_URL=https://n8n.datastack.viagroup.com.br/webhook/seu_webhook_aqui
VITE_WEBHOOK_NC_RESUMO_URL=https://n8n.datastack.viagroup.com.br/webhook/seu_webhook_aqui

# -------------------------------------------
# Servidor de Desenvolvimento
# -------------------------------------------
VITE_SERVER_PORT=3000

# -------------------------------------------
# Segurança - Limitação de Login
# -------------------------------------------
# Máximo de tentativas de login falhas antes do bloqueio temporário
LIMITAR_RETRY_LOGIN=5

# Tempo de bloqueio em minutos após atingir o limite de tentativas
LOGIN_LOCKOUT_MINUTES=15

# -------------------------------------------
# Cloudflare Turnstile (Proteção Anti-Bot)
# -------------------------------------------
# SITE_KEY: chave pública do widget (frontend)
# SECRET_KEY: chave secreta para validação server-side (configurar no Vercel Dashboard)
SITE_KEY=sua_turnstile_site_key_aqui
